<Window x:Class="DadosDeEmpregados.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DadosDeEmpregados"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Label Content="Dados do Empregado" HorizontalAlignment="Left" Margin="69,40,0,0" VerticalAlignment="Top" FontSize="25" FontWeight="Bold"/>
        <Label Content="Matrícula" HorizontalAlignment="Left" Margin="43,110,0,0" VerticalAlignment="Top"/>
        <Label Content="CPF" HorizontalAlignment="Left" Margin="43,149,0,0" VerticalAlignment="Top"/>
        <Label Content="Nome" HorizontalAlignment="Left" Margin="43,191,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.397,-0.386"/>
        <Label Content="Endereço" HorizontalAlignment="Left" Margin="35,230,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="matricula" HorizontalAlignment="Left" Margin="107,110,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="436" Height="31"/>
        <TextBox x:Name="cpf" HorizontalAlignment="Left" Margin="107,151,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="436" Height="31"/>
        <TextBox x:Name="nome" HorizontalAlignment="Left" Margin="107,191,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="436" Height="31"/>
        <TextBox x:Name="endereco" HorizontalAlignment="Left" Margin="107,230,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="436" Height="58"/>
        <Rectangle HorizontalAlignment="Left" Height="165" Margin="584,123,0,0" Stroke="Black" VerticalAlignment="Top" Width="182"/>
        <Button x:Name="pesquisar" Content="Pesquisar" HorizontalAlignment="Left" Margin="606,172,0,0" VerticalAlignment="Top" Width="138" Height="28" Click="pesquisar_Click"/>
        <Button x:Name="salvar" Content="Salvar" HorizontalAlignment="Left" Margin="606,138,0,0" VerticalAlignment="Top" Width="138" Height="28" Click="salvar_Click" Background="#4FC3F7" />
        <Button x:Name="excluir" Content="Excluir" HorizontalAlignment="Left" Margin="606,206,0,0" VerticalAlignment="Top" Width="138" Height="28" Click="excluir_Click"/>
        <Button x:Name="limpar" Content="Limpar" HorizontalAlignment="Left" Margin="606,243,0,0" VerticalAlignment="Top" Width="138" Height="28" Click="limpar_Click"/>
        <DataGrid x:Name="dados" HorizontalAlignment="Center" Height="123" Margin="0,301,0,0" VerticalAlignment="Top" Width="760" 
                  
               
                  
                  
                  />
        <Label x:Name="status" Content="" HorizontalAlignment="Left" Height="31" Margin="613,46,0,0" VerticalAlignment="Top" Width="124" FontSize="14" FontWeight="Bold"/>


    </Grid>
</Window>
